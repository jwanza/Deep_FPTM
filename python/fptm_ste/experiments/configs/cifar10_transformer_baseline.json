{
  "label": "cifar10_transformer_baseline",
  "description": "Baseline Swin/Vision transformer hybrid without KD.",
  "tags": ["transformer-smoke", "cifar-full", "transformer", "baseline"],
  "command": [
    "{python}",
    "{run_mnist_equiv}",
    "--dataset",
    "cifar10",
    "--models",
    "transformer",
    "--epochs",
    "5",
    "--batch-size",
    "64",
    "--transformer-arch",
    "swin",
    "--transformer-depths",
    "2,2",
    "--transformer-stage-heads",
    "3,6",
    "--transformer-embed-dims",
    "96,192",
    "--transformer-window",
    "4",
    "--transformer-clauses",
    "192",
    "--transformer-drop-path",
    "0.1",
    "--mixup-alpha",
    "0.0",
    "--label-smoothing",
    "0.0"
  ],
  "output_json": "cifar10/transformer/baseline.json"
}


