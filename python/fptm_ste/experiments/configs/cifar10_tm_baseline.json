{
  "label": "cifar10_tm_baseline",
  "description": "CIFAR-10 STE TM baseline without mixup/cutmix.",
  "tags": ["cifar-smoke", "cifar-full", "tm", "baseline"],
  "command": [
    "{python}",
    "{run_mnist_equiv}",
    "--dataset",
    "cifar10",
    "--models",
    "tm",
    "--epochs",
    "5",
    "--batch-size",
    "128",
    "--test-batch-size",
    "256",
    "--label-smoothing",
    "0.0",
    "--mixup-alpha",
    "0.0",
    "--cutmix-alpha",
    "0.0",
    "--export-compiled",
    "False"
  ],
  "output_json": "cifar10/tm/baseline.json"
}



