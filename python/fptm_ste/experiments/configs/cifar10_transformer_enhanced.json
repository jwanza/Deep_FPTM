{
  "label": "cifar10_transformer_enhanced",
  "description": "Transformer hybrid with clause attention, KD, and contrastive heads.",
  "tags": ["transformer-smoke", "cifar-full", "transformer", "enhanced"],
  "command": [
    "{python}",
    "{run_mnist_equiv}",
    "--dataset",
    "cifar10",
    "--models",
    "transformer",
    "--epochs",
    "8",
    "--batch-size",
    "64",
    "--transformer-arch",
    "swin",
    "--transformer-depths",
    "2,2",
    "--transformer-stage-heads",
    "3,6",
    "--transformer-embed-dims",
    "96,192",
    "--transformer-window",
    "4",
    "--transformer-clauses",
    "256",
    "--transformer-drop-path",
    "0.15",
    "--transformer-clause-attention",
    "True",
    "--transformer-clause-align-weight",
    "0.2",
    "--transformer-clause-align-temp",
    "1.5",
    "--transformer-attn-guidance-weight",
    "0.05",
    "--transformer-contrastive-weight",
    "0.1",
    "--transformer-contrastive-temp",
    "0.1",
    "--distill-teacher-weight",
    "0.3",
    "--distill-teacher-temp",
    "2.0",
    "--label-smoothing",
    "0.1",
    "--mixup-alpha",
    "0.3",
    "--cutmix-alpha",
    "0.2"
  ],
  "output_json": "cifar10/transformer/enhanced.json"
}

