{
  "label": "cifar10_deep_cstcm_baseline",
  "description": "Deep-CSTCM baseline mirroring historical configuration.",
  "tags": ["cifar-full", "deep_cstcm", "baseline"],
  "command": [
    "{python}",
    "{run_mnist_equiv}",
    "--dataset",
    "cifar10",
    "--models",
    "deep_cstcm",
    "--epochs",
    "15",
    "--batch-size",
    "128",
    "--deepctm-channels",
    "64,128,256",
    "--deepctm-kernels",
    "3,3,3",
    "--deepctm-strides",
    "1,1,1",
    "--deepctm-pools",
    "2,2,2",
    "--deepctm-clauses",
    "256,256,512",
    "--deepctm-head-clauses",
    "1024",
    "--deepctm-dropout",
    "0.1",
    "--deepctm-aux-weight",
    "0.05",
    "--ctm-ema-decay",
    "0.0",
    "--ctm-self-distill-weight",
    "0.0",
    "--export-compiled",
    "False"
  ],
  "output_json": "cifar10/deep_cstcm/baseline.json"
}


