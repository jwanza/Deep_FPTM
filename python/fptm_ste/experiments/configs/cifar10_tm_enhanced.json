{
  "label": "cifar10_tm_enhanced",
  "description": "CIFAR-10 STE TM with smoothing, mixup, cutmix, KD hooks enabled.",
  "tags": ["cifar-smoke", "cifar-full", "tm", "enhanced"],
  "command": [
    "{python}",
    "{run_mnist_equiv}",
    "--dataset",
    "cifar10",
    "--models",
    "tm",
    "--epochs",
    "10",
    "--batch-size",
    "128",
    "--test-batch-size",
    "256",
    "--label-smoothing",
    "0.15",
    "--mixup-alpha",
    "0.4",
    "--cutmix-alpha",
    "0.4",
    "--distill-teacher-weight",
    "0.2",
    "--distill-teacher-temp",
    "2.0",
    "--export-compiled",
    "False"
  ],
  "output_json": "cifar10/tm/enhanced.json"
}



