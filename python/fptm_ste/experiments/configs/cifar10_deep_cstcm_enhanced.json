{
  "label": "cifar10_deep_cstcm_enhanced",
  "description": "Deep-CSTCM with EMA self-distillation, clause curriculum, and KD.",
  "tags": ["cifar-full", "deep_cstcm", "enhanced"],
  "command": [
    "{python}",
    "{run_mnist_equiv}",
    "--dataset",
    "cifar10",
    "--models",
    "deep_cstcm",
    "--epochs",
    "25",
    "--batch-size",
    "128",
    "--deepctm-channels",
    "64,128,256",
    "--deepctm-kernels",
    "3,3,3",
    "--deepctm-strides",
    "1,1,1",
    "--deepctm-pools",
    "2,2,2",
    "--deepctm-clauses",
    "256,256,512",
    "--deepctm-head-clauses",
    "1024",
    "--deepctm-dropout",
    "0.1",
    "--deepctm-aux-weight",
    "0.1",
    "--ctm-ema-decay",
    "0.995",
    "--ctm-self-distill-weight",
    "0.1",
    "--ctm-self-distill-temp",
    "2.0",
    "--label-smoothing",
    "0.1",
    "--mixup-alpha",
    "0.2",
    "--cutmix-alpha",
    "0.2",
    "--contrastive-weight",
    "0.05",
    "--export-compiled",
    "False"
  ],
  "output_json": "cifar10/deep_cstcm/enhanced.json"
}


